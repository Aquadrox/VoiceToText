<?xml version="1.0" encoding="utf-8"?>
<!-- Édition « bulle » : le service d'accessibilité de la bulle de dictée. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Bulle de dictée : service d'accessibilité activé par l'utilisateur. -->
        <service
            android:name=".BubbleService"
            android:exported="true"
            android:label="@string/bubble_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bubble_service" />
        </service>
    </application>
</manifest>
